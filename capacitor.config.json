{
  "appId": "com.hiddenfeeai.app",
  "appName": "HiddenFeeAI",
  "webDir": "client/dist",
  "android": {
    "allowMixedContent": true
  },
  "server": {
    "hostname": "app",
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": ["checkout.stripe.com", "*.stripe.com"]
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#050510",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
