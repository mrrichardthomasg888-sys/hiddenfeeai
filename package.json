{
  "name": "hiddenfeeai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "worker"
  ],
  "scripts": {
    "dev": "concurrently -n CLIENT,SERVER -c blue,green \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "dev:worker": "npm run dev --workspace worker",
    "deploy:worker": "npm run deploy --workspace worker",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "build:worker": "npm run build --workspace worker",
    "android:sync": "npm run build --workspace client && npx cap sync",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "@types/sharp": "^0.31.1",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@google/genai": "^1.52.0",
    "devl": "^2.0.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.8.69",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.11"
  }
}
