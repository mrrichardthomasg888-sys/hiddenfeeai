# ==================================================
# HiddenFeeAI — Environment Variables Example
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==================================================

# Server
PORT=8787
NODE_ENV=development

# Google Gemini AI (server-side only — never exposed to client)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Recommended: gemini-3.5-flash-lite (fast, cost-effective document understanding)
# Also supported: gemini-2.0-flash (faster, lower cost), gemini-1.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_USD_CENTS=1500

# Payment gate (set to true to bypass payment for local dev/testing)
TEST_MODE_SKIP_PAYMENT=false

# Upload limits
MAX_UPLOAD_SIZE_MB=25

# Limited beta: show the mobile camera scanner in production builds.
# Local development shows it automatically. Leave false until beta approval.
VITE_ENABLE_DOCUMENT_SCANNER=false

# Frontend origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
