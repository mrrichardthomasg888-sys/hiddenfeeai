# ==================================================
# HiddenFeeAI — Environment Variables (local dev)
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==================================================

# Server
PORT=8787
NODE_ENV=development

# DeepSeek AI (server-side only — never exposed to client)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_USD_CENTS=1500

# Local dev convenience — skips real Stripe checkout so the full
# upload -> analyze -> report flow can be tested without live keys.
# Set to "false" once Stripe test keys are configured.
TEST_MODE_SKIP_PAYMENT=true

# Upload limits
MAX_UPLOAD_SIZE_MB=25

# Frontend origin (CORS)
CLIENT_ORIGIN=http://localhost:5173
